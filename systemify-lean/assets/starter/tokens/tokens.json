{
  "$description": "The one source for every value. Run `npm run tokens` after a change. Demo values: replace them with what the audit measured.",
  "$extensions": { "systemify": { "prefix": "fs" } },
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": { "$value": "#FFFFFF" },
        "100": { "$value": "#F4F2EE" },
        "300": { "$value": "#CFCBC3" },
        "600": { "$value": "#5E5A53" },
        "900": { "$value": "#1C1B19" }
      },
      "brand": { "600": { "$value": "#1F5F4A" }, "700": { "$value": "#174A3A" } },
      "red": { "700": { "$value": "#B3261E" } }
    },
    "font": {
      "family": { "$type": "fontFamily", "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] } },
      "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "semibold": { "$value": 600 } },
      "size": {
        "$type": "dimension",
        "14": { "$value": "0.875rem" }, "16": { "$value": "1rem" }, "18": { "$value": "1.125rem" },
        "22": { "$value": "1.375rem" }, "28": { "$value": "1.75rem" }, "36": { "$value": "2.25rem" }, "48": { "$value": "3rem" }
      },
      "line-height": { "$type": "number", "tight": { "$value": 1.15 }, "snug": { "$value": 1.3 }, "normal": { "$value": 1.55 } },
      "tracking": { "$type": "dimension", "tight": { "$value": "-0.01em" }, "normal": { "$value": "0em" }, "wide": { "$value": "0.04em" } }
    },
    "space": {
      "$type": "dimension",
      "4": { "$value": "0.25rem" }, "8": { "$value": "0.5rem" }, "12": { "$value": "0.75rem" }, "16": { "$value": "1rem" },
      "24": { "$value": "1.5rem" }, "32": { "$value": "2rem" }, "48": { "$value": "3rem" }, "64": { "$value": "4rem" }, "96": { "$value": "6rem" }
    },
    "size": { "$type": "dimension", "1152": { "$value": "72rem" } },
    "breakpoint": { "$type": "dimension", "tablet": { "$value": "48em" }, "desktop": { "$value": "75em" } }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "text": {
        "default": { "$value": "{primitive.color.neutral.900}", "$description": "Body text and headings." },
        "muted": { "$value": "{primitive.color.neutral.600}", "$description": "Meta text, captions." },
        "link": { "$value": "{primitive.color.brand.600}" },
        "on-inverse": { "$value": "{primitive.color.neutral.0}", "$description": "Text on surface.inverse." },
        "error": { "$value": "{primitive.color.red.700}" }
      },
      "surface": {
        "default": { "$value": "{primitive.color.neutral.0}" },
        "subtle": { "$value": "{primitive.color.neutral.100}" },
        "inverse": { "$value": "{primitive.color.brand.700}" }
      },
      "border": {
        "default": { "$value": "{primitive.color.neutral.300}", "$description": "Dividers. Decorative, no contrast need." },
        "strong": { "$value": "{primitive.color.neutral.600}", "$description": "Form field borders. 3:1." },
        "focus": { "$value": "{primitive.color.brand.600}" }
      },
      "action": {
        "primary-background": { "$value": "{primitive.color.brand.600}" },
        "primary-background-hover": { "$value": "{primitive.color.brand.700}" },
        "primary-foreground": { "$value": "{primitive.color.neutral.0}" }
      }
    },
    "font": {
      "size": {
        "$type": "dimension",
        "display": { "$value": "{primitive.font.size.36}", "$extensions": { "systemify": { "modes": { "tablet": "{primitive.font.size.48}" } } } },
        "heading-lg": { "$value": "{primitive.font.size.28}", "$extensions": { "systemify": { "modes": { "tablet": "{primitive.font.size.36}" } } } },
        "heading-md": { "$value": "{primitive.font.size.22}", "$extensions": { "systemify": { "modes": { "tablet": "{primitive.font.size.28}" } } } },
        "body-lg": { "$value": "{primitive.font.size.18}" },
        "body-md": { "$value": "{primitive.font.size.16}" },
        "label": { "$value": "{primitive.font.size.14}" }
      }
    },
    "text": {
      "$type": "typography",
      "loud": { "$description": "Voice: loud. The one hero line per page. Usually h1.", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.semibold}", "fontSize": "{semantic.font.size.display}", "lineHeight": "{primitive.font.line-height.tight}", "letterSpacing": "{primitive.font.tracking.tight}" } },
      "strong": { "$description": "Voice: strong. Section titles. Usually h2.", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.semibold}", "fontSize": "{semantic.font.size.heading-lg}", "lineHeight": "{primitive.font.line-height.tight}", "letterSpacing": "{primitive.font.tracking.tight}" } },
      "firm": { "$description": "Voice: firm. Card and list titles. Usually h3.", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.semibold}", "fontSize": "{semantic.font.size.heading-md}", "lineHeight": "{primitive.font.line-height.snug}", "letterSpacing": "{primitive.font.tracking.normal}" } },
      "warm": { "$description": "Voice: warm. Intro paragraphs.", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.regular}", "fontSize": "{semantic.font.size.body-lg}", "lineHeight": "{primitive.font.line-height.normal}", "letterSpacing": "{primitive.font.tracking.normal}" } },
      "calm": { "$description": "Voice: calm. Running text. The default.", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.regular}", "fontSize": "{semantic.font.size.body-md}", "lineHeight": "{primitive.font.line-height.normal}", "letterSpacing": "{primitive.font.tracking.normal}" } },
      "quiet": { "$description": "Voice: quiet. Labels, meta, buttons, nav.", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.semibold}", "fontSize": "{semantic.font.size.label}", "lineHeight": "{primitive.font.line-height.snug}", "letterSpacing": "{primitive.font.tracking.wide}" } }
    },
    "space": {
      "$type": "dimension",
      "3xs": { "$value": "{primitive.space.4}" }, "2xs": { "$value": "{primitive.space.8}" }, "xs": { "$value": "{primitive.space.12}" },
      "s": { "$value": "{primitive.space.16}" }, "m": { "$value": "{primitive.space.24}" }, "l": { "$value": "{primitive.space.32}" },
      "xl": { "$value": "{primitive.space.48}", "$extensions": { "systemify": { "modes": { "desktop": "{primitive.space.64}" } } } },
      "section": { "$value": "{primitive.space.64}", "$description": "Space between page sections.", "$extensions": { "systemify": { "modes": { "desktop": "{primitive.space.96}" } } } },
      "page-margin": { "$value": "{primitive.space.24}", "$extensions": { "systemify": { "modes": { "tablet": "{primitive.space.32}", "desktop": "{primitive.space.48}" } } } }
    },
    "size": { "$type": "dimension", "content": { "$value": "{primitive.size.1152}" } },
    "radius": { "$type": "dimension", "control": { "$value": "0.25rem" } }
  }
}
