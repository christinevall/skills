      }
    },
    "shadow": {
      "$type": "shadow",
      "overlay": {
        "$value": "{primitive.shadow.lg}"
      }
    }
  },
  "component": {
    "button": {
      "height": {
        "$type": "dimension",
        "$value": "{primitive.size.39}"
